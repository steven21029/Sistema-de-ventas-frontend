# Puerto publicado por Docker para el frontend.
FRONTEND_PORT=5173

# Backend accesible desde el contenedor, no desde el navegador.
BACKEND_URL=http://host.docker.internal:8000
BACKEND_HOST=127.0.0.1:8000

# Estas variables se incorporan al bundle durante la construccion.
VITE_API_URL=/api/v1
VITE_EMPRESA_SLUG=
